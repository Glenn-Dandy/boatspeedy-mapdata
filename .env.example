# Adresse und Port, auf denen die Kartendaten ausgeliefert werden.
# Der Reverse-Proxy läuft auf einem anderen Rechner, deshalb 0.0.0.0.
MAPDATA_BIND=0.0.0.0
MAPDATA_PORT=8081

# Benutzer, dem die erzeugten Kacheln gehören sollen — normalerweise der eigene.
# Ermitteln mit: id -u ; id -g
HOST_UID=1000
HOST_GID=1000
